{
 "align_labels_right": 0,
 "creation": "2026-05-07 13:15:00.000000",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Hotel Reservation",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 12,
 "html": "{% set guest_doc = frappe.get_cached_doc('Guest', doc.guest) if doc.guest else None %}\n{% set room_doc = frappe.get_cached_doc('Hotel Room', doc.room) if doc.room else None %}\n{% set reception = frappe.get_cached_doc('Hotel Reception', doc.hotel_reception) if doc.hotel_reception else None %}\n{% set nights = (doc.departure_date | as_date - doc.arrival_date | as_date).days if (doc.arrival_date and doc.departure_date) else 0 %}\n\n<div style=\"max-width: 720px; margin: 0 auto; padding: 24px; font-family: Arial, Helvetica, sans-serif; color: #1f2937;\">\n\n  <div style=\"display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #0F766E; padding-bottom: 12px; margin-bottom: 16px;\">\n    <div>\n      <div style=\"font-size: 22px; font-weight: 700; color: #0F766E;\">Reservation Confirmation</div>\n      <div style=\"font-size: 12px; color: #6b7280;\">{{ doc.name }}</div>\n    </div>\n    <div style=\"text-align: right;\">\n      <div style=\"font-size: 14px; font-weight: 700;\">{{ reception.reception_name if reception else '' }}</div>\n      <div style=\"font-size: 11px; color: #6b7280;\">{{ frappe.utils.now_datetime().strftime('%d %b %Y %H:%M') }}</div>\n    </div>\n  </div>\n\n  <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;\">\n    <div>\n      <div style=\"font-size: 11px; text-transform: uppercase; color: #6b7280; letter-spacing: 0.05em;\">Guest</div>\n      <div style=\"font-size: 16px; font-weight: 600; margin-top: 2px;\">{{ guest_doc.full_name if guest_doc else doc.guest }}</div>\n      {% if guest_doc and guest_doc.email_id %}<div style=\"font-size: 12px; color: #4b5563;\">{{ guest_doc.email_id }}</div>{% endif %}\n      {% if guest_doc and guest_doc.mobile_no %}<div style=\"font-size: 12px; color: #4b5563;\">{{ guest_doc.mobile_no }}</div>{% endif %}\n    </div>\n    <div>\n      <div style=\"font-size: 11px; text-transform: uppercase; color: #6b7280; letter-spacing: 0.05em;\">Status</div>\n      <div style=\"font-size: 16px; font-weight: 600; margin-top: 2px; color: {% if doc.status == 'Cancelled' %}#dc2626{% elif doc.status == 'Checked Out' %}#6b7280{% else %}#0F766E{% endif %};\">{{ doc.status }}</div>\n    </div>\n  </div>\n\n  <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 13px;\">\n    <thead>\n      <tr style=\"background: #f3f4f6;\">\n        <th style=\"padding: 8px 12px; text-align: left; border-bottom: 1px solid #d1d5db;\">Arrival</th>\n        <th style=\"padding: 8px 12px; text-align: left; border-bottom: 1px solid #d1d5db;\">Departure</th>\n        <th style=\"padding: 8px 12px; text-align: left; border-bottom: 1px solid #d1d5db;\">Nights</th>\n        <th style=\"padding: 8px 12px; text-align: left; border-bottom: 1px solid #d1d5db;\">Room Type</th>\n        <th style=\"padding: 8px 12px; text-align: left; border-bottom: 1px solid #d1d5db;\">Room</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        <td style=\"padding: 10px 12px; border-bottom: 1px solid #e5e7eb;\">{{ frappe.utils.format_date(doc.arrival_date, 'medium') }}</td>\n        <td style=\"padding: 10px 12px; border-bottom: 1px solid #e5e7eb;\">{{ frappe.utils.format_date(doc.departure_date, 'medium') }}</td>\n        <td style=\"padding: 10px 12px; border-bottom: 1px solid #e5e7eb;\">{{ nights }}</td>\n        <td style=\"padding: 10px 12px; border-bottom: 1px solid #e5e7eb;\">{{ doc.room_type or '—' }}</td>\n        <td style=\"padding: 10px 12px; border-bottom: 1px solid #e5e7eb;\">{{ doc.room or 'Will be assigned at check-in' }}</td>\n      </tr>\n    </tbody>\n  </table>\n\n  {% if doc.rate_plan %}\n  <div style=\"font-size: 12px; color: #4b5563; margin-bottom: 8px;\">\n    <strong>Rate Plan:</strong> {{ doc.rate_plan }}\n    {% if doc.is_complimentary %}<span style=\"margin-left: 8px; padding: 2px 8px; background: #d1fae5; color: #065f46; border-radius: 4px; font-size: 11px;\">COMPLIMENTARY</span>{% endif %}\n  </div>\n  {% endif %}\n\n  {% if doc.is_company_guest and doc.company %}\n  <div style=\"padding: 10px; background: #fef3c7; border-left: 3px solid #f59e0b; font-size: 12px; margin-bottom: 16px;\">\n    Charges to be billed to <strong>{{ doc.company }}</strong>\n  </div>\n  {% endif %}\n\n  <div style=\"margin-top: 28px; padding-top: 16px; border-top: 1px dashed #d1d5db; font-size: 11px; color: #6b7280; text-align: center;\">\n    Thank you for choosing us. Please present this confirmation at check-in.\n  </div>\n\n</div>",
 "idx": 0,
 "line_breaks": 0,
 "modified": "2026-05-07 13:15:00.000000",
 "modified_by": "Administrator",
 "module": "Hospitality Core",
 "name": "Reservation Confirmation",
 "owner": "Administrator",
